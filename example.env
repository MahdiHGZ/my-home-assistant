# Tapo camera
TAPO_IP=192.168.1.x
TAPO_USERNAME=your_camera_user
TAPO_PASSWORD=your_camera_password
TAPO_CLOUD_PASSWORD=optional_cloud_password

# Xiaomi Vacuum S20 (MIoT) — get token via Xiaomi Cloud Tokens Extractor
VACUUM_IP=192.168.1.x
VACUUM_TOKEN=your_32_character_device_token

# Xiaomi Air Purifier 4 Lite (MIoT)
AIRPURIFIER_IP=192.168.1.x
AIRPURIFIER_TOKEN=your_32_character_device_token

# Optional: require this password to delete captured images from the web UI.
# Leave unset (or empty) to allow deletion without a password.
MOMENTS_DELETE_PASSWORD=

# Optional HTTP Basic authentication. Usernames are browser and panel.
# Any configured password enables authentication on every route.
COUKAB_BROWSER_PASSWORD=
COUKAB_PANEL_PASSWORD=
# During rotation the previous password works until removed and restarted.
COUKAB_BROWSER_PASSWORD_PREVIOUS=
COUKAB_PANEL_PASSWORD_PREVIOUS=
# Optional comma-separated exact browser origins when using a reverse proxy.
COUKAB_ALLOWED_ORIGINS=

# Local history, routines and schedule receipts. Relative to the service directory.
COUKAB_STATE_DB=coukab.sqlite3

# Optional local discovery. Use the manual IP address if mDNS is unavailable.
COUKAB_MDNS=1
COUKAB_LOCAL_NAME=coukab

# Optional MQTT 5 broker. Select shared entities and routines at /setup.
COUKAB_MQTT_HOST=
COUKAB_MQTT_PORT=1883
COUKAB_MQTT_USER=
COUKAB_MQTT_PASSWORD=
COUKAB_MQTT_TLS=0
