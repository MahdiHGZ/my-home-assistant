# Tapo camera
TAPO_IP=192.168.1.x
TAPO_USERNAME=your_camera_user
TAPO_PASSWORD=your_camera_password
TAPO_CLOUD_PASSWORD=optional_cloud_password

# Xiaomi Vacuum S20 (MIoT) — get token via Xiaomi Cloud Tokens Extractor
VACUUM_IP=192.168.1.x
VACUUM_TOKEN=your_32_character_device_token

# Xiaomi Air Purifier 4 Lite (MIoT)
AIRPURIFIER_IP=192.168.1.x
AIRPURIFIER_TOKEN=your_32_character_device_token

# Optional: require this password to delete captured images from the web UI.
# Leave unset (or empty) to allow deletion without a password.
MOMENTS_DELETE_PASSWORD=
