// secrets.h — network credentials and server address.
// Copy to secrets.h and fill in your values. Do not commit secrets.h.
#pragma once

const char* WIFI_SSID     = "your-wifi-ssid";
const char* WIFI_PASSWORD = "your-wifi-password";

// IMPORTANT: do NOT use localhost here. From the ESP32, localhost means
// the ESP32 itself. Use the LAN IP of the machine running web_server.py.
const char* API_HOST = "192.168.1.x";
const uint16_t API_PORT = 8080;
